{
  "name": "tkitchen",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tkitchen": "modules/cli/lib/adapters/main.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "node scripts/lint-ratchet.ts",
    "test": "vitest run",
    "test:sim": "vitest run --config vitest.sim.config.ts",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.web.json",
    "build:web": "vite build",
    "verify:structure": "node scripts/check-module-structure.mjs",
    "verify": "npm run format:check && npm run lint && npm run lint:guard && npm run typecheck && npm run seams && npm run verify:structure && npm test && npm run test:sim --if-present && npm run build:web",
    "seams": "depcruise modules index.ts src sim scripts deploy fixtures --config .dependency-cruiser.cjs",
    "lint:baseline": "node scripts/lint-ratchet.ts --write",
    "lint:guard": "node scripts/lint-config-guard.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.9.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
