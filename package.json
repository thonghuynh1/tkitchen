{
  "name": "tkitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tkitchen": "src/cli/tkitchen.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:sim": "vitest run --config vitest.sim.config.ts",
    "typecheck": "tsgo --noEmit",
    "verify:structure": "node scripts/check-module-structure.mjs",
    "verify": "npm run lint && npm run typecheck && npm run seams && npm run verify:structure && npm test && npm run test:sim --if-present",
    "seams": "depcruise src tests scripts --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dependency-cruiser": "^18.9.0",
    "oxlint": "^1.94.0",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "typescript": "^5.8.3",
    "vitest": "5.1.0"
  }
}
